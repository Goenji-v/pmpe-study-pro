{
  "name": "pmpe-study-pro",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "concurrently \"vite --host 0.0.0.0\" \"tsx watch server/secureEntry.ts\"",
    "dev:web": "vite --host 0.0.0.0",
    "dev:api": "tsx watch server/secureEntry.ts",
    "start:api": "tsx server/secureEntry.ts",
    "test": "node --import tsx --test server/*.test.ts",
    "lint": "oxlint src server",
    "build": "tsc -b && vite build",
    "check": "npm run lint && npm test && npm run build",
    "e2e": "playwright test",
    "e2e:smoke": "playwright test e2e/smoke.spec.ts",
    "e2e:auth": "playwright test e2e/authenticated-critical.spec.ts e2e/mobile-navigation.spec.ts e2e/mobile-secondary.spec.ts",
    "e2e:mobile-secondary": "playwright test e2e/mobile-secondary.spec.ts --project=mobile-chrome",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@google/genai": "^2.19.0",
    "@supabase/supabase-js": "^2.112.4",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "framer-motion": "^13.1.1",
    "lucide-react": "^1.34.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "oxlint": "^1.80.0",
    "tsx": "^4.23.12",
    "typescript": "~7.0.2",
    "vite": "^8.2.2"
  }
}
