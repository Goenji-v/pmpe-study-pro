# Frontend (Vercel)
# Copie os valores reais para Project Settings > Environment Variables no Vercel.
# NUNCA coloque GEMINI_API_KEY no frontend/Vercel.

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=SUA_CHAVE_ANON_PUBLICA
VITE_API_URL=https://pmpe-study-pro-api.onrender.com
# DSN público do projeto Frontend no Sentry. Deixe vazio para desativar.
VITE_SENTRY_DSN=

# API (Render)
# DSN do projeto Backend no Sentry. Deixe vazio para desativar.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
GEMINI_API_KEY=SUA_CHAVE_PRIVADA_DO_GEMINI
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
SUPABASE_URL=https://kibnmdwabpiwyprkrhvq.supabase.co
# Opcional no servidor porque o frontend também envia a chave pública no cabeçalho.
SUPABASE_ANON_KEY=SUA_CHAVE_ANON_PUBLICA
# Separe múltiplas origens por vírgula. A produção principal já possui fallback seguro.
FRONTEND_URL=https://pmpe-study-pro-two.vercel.app
# Porta interna opcional usada pelo proxy autenticado. Não exponha publicamente.
# INTERNAL_API_PORT=3002

# Study Pro Storage (API/Render) — Cloudflare Worker + R2 privado.
STUDY_STORAGE_WORKER_URL=https://study-pro-storage.studypro-storage.workers.dev
STUDY_STORAGE_BUCKET=study-pro-private
# Chave privada PKCS8 em Base64 usada somente pelo backend para assinar acessos temporários.
STUDY_STORAGE_PRIVATE_KEY_B64=
# 5 GiB por arquivo e blocos de 32 MiB no upload multipart.
STUDY_STORAGE_MAX_FILE_BYTES=5368709120
STUDY_STORAGE_CHUNK_BYTES=33554432
