\ No newline at end of file
+.cloud-status-wrap {
+  position: relative;
+}
+
+.cloud-status {
+  display: flex;
+  align-items: center;
+  gap: 7px;
+  min-height: 32px;
+  padding: 7px 10px;
+  color: inherit;
+  background: #0f172a;
+  border: 1px solid #334155;
+  border-radius: 999px;
+  cursor: pointer;
+}
+
+.cloud-status-dot {
+  width: 8px;
+  height: 8px;
+  flex-shrink: 0;
+  background: #64748b;
+  border-radius: 50%;
+}
+
+.cloud-status strong {
+  color: #cbd5e1;
+  font-size: 10px;
+  white-space: nowrap;
+}
+
+.cloud-status-chevron {
+  color: #64748b;
+  font-size: 12px;
+  line-height: 1;
+}
+
+.cloud-status-sincronizado .cloud-status-dot {
+  background: #22c55e;
+  box-shadow: 0 0 9px rgba(34, 197, 94, 0.6);
+}
+
+.cloud-status-salvando .cloud-status-dot,
+.cloud-status-carregando .cloud-status-dot {
+  background: #f59e0b;
+  animation: cloud-status-pulse 1.1s ease-in-out infinite;
+}
+
+.cloud-status-erro .cloud-status-dot {
+  background: #ef4444;
+}
+
+.cloud-status-offline .cloud-status-dot {
+  background: #94a3b8;
+}
+
+.cloud-status-conflito {
+  border-color: rgba(245, 158, 11, 0.55);
+}
+
+.cloud-status-conflito .cloud-status-dot {
+  background: #f59e0b;
+  box-shadow: 0 0 9px rgba(245, 158, 11, 0.45);
+}
+
+.cloud-status-painel {
+  position: absolute;
+  top: calc(100% + 10px);
+  right: 0;
+  z-index: 1200;
+  width: min(390px, calc(100vw - 28px));
+  padding: 16px;
+  color: #e2e8f0;
+  background: #0f172a;
+  border: 1px solid #334155;
+  border-radius: 16px;
+  box-shadow: 0 20px 55px rgba(2, 6, 23, 0.35);
+}
+
+.cloud-status-painel-cabecalho {
+  display: flex;
+  align-items: flex-start;
+  justify-content: space-between;
+  gap: 12px;
+}
+
+.cloud-status-painel-cabecalho > div {
+  display: grid;
+  gap: 4px;
+}
+
+.cloud-status-painel-cabecalho span,
+.cloud-status-metricas span {
+  color: #94a3b8;
+  font-size: 9px;
+  font-weight: 800;
+  letter-spacing: 0.08em;
+  text-transform: uppercase;
+}
+
+.cloud-status-painel-cabecalho strong {
+  color: #f8fafc;
+  font-size: 14px;
+}
+
+.cloud-status-badge {
+  padding: 5px 8px;
+  color: #cbd5e1;
+  background: #1e293b;
+  border-radius: 999px;
+  font-size: 9px;
+  font-weight: 800;
+  white-space: nowrap;
+}
+
+.cloud-status-metricas {
+  display: grid;
+  grid-template-columns: repeat(3, minmax(0, 1fr));
+  gap: 8px;
+  margin-top: 14px;
+}
+
+.cloud-status-metricas > div {
+  min-width: 0;
+  padding: 10px;
+  background: #111c30;
+  border: 1px solid #26354d;
+  border-radius: 11px;
+}
+
+.cloud-status-metricas strong {
+  display: block;
+  margin-top: 6px;
+  color: #f8fafc;
+  font-size: 11px;
+  line-height: 1.35;
+  white-space: normal;
+}
+
+.cloud-status-mensagem {
+  margin: 12px 0 0;
+  color: #94a3b8;
+  font-size: 11px;
+  line-height: 1.5;
+}
+
+.cloud-status-painel-acoes {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 8px;
+  margin-top: 14px;
+}
+
+.cloud-status-painel-acoes button,
+.cloud-status-painel-acoes a {
+  min-height: 32px;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  padding: 0 10px;
+  color: #e2e8f0;
+  background: #1e293b;
+  border: 1px solid #334155;
+  border-radius: 9px;
+  font-size: 10px;
+  font-weight: 800;
+  text-decoration: none;
+  cursor: pointer;
+}
+
+.cloud-status-painel-acoes button:disabled {
+  cursor: not-allowed;
+  opacity: 0.55;
+}
+
+@keyframes cloud-status-pulse {
+  0%, 100% { opacity: 0.45; }
+  50% { opacity: 1; }
+}
+
+@media (max-width: 720px) {
+  .cloud-status strong {
+    max-width: 115px;
+    overflow: hidden;
+    text-overflow: ellipsis;
+  }
+
+  .cloud-status-painel {
+    position: fixed;
+    top: 78px;
+    right: 14px;
+  }
+
+  .cloud-status-metricas {
+    grid-template-columns: 1fr;
+  }
+}
+
+/* Etapa 20.1 — status compacto no celular */
+@media (max-width: 600px) {
+  .cloud-status {
+    min-height: 36px;
+    height: 36px;
+    padding: 0 9px;
+    gap: 6px;
+  }
+
+  .cloud-status strong {
+    font-size: 9px;
+  }
+
+  .cloud-status-dot {
+    width: 7px;
+    height: 7px;
+  }
+}
