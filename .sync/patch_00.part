+            </button>
             <button type="button" onClick={this.recarregar}>
-              Recarregar
+              Recarregar página
             </button>
             <button type="button" onClick={this.voltarAoInicio}>
-              Voltar ao início
+              Ir para o Dashboard
             </button>
           </div>
         </section>
