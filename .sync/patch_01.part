diff -ruN '--exclude=*.png' '--exclude=*.svg' base1112_clean/src/components/RuntimeErrorGuard/RuntimeErrorGuard.tsx latest_clean/src/components/RuntimeErrorGuard/RuntimeErrorGuard.tsx
--- base1112_clean/src/components/RuntimeErrorGuard/RuntimeErrorGuard.tsx	1970-01-01 00:00:00.000000000 +0000
+++ latest_clean/src/components/RuntimeErrorGuard/RuntimeErrorGuard.tsx	2026-08-14 22:14:59.000000000 +0000
@@ -0,0 +1,45 @@
+import { useEffect, useRef } from "react";
+
+import { useToast } from "../../context/ToastContext";
+import { registrarErroRuntime } from "../../services/seguranca/diagnosticoErroService";
+
+export default function RuntimeErrorGuard() {
+  const { showToast } = useToast();
+  const ultimoAvisoRef = useRef(0);
+
+  useEffect(() => {
+    function avisar() {
+      const agora = Date.now();
+      if (agora - ultimoAvisoRef.current < 5000) return;
+
+      ultimoAvisoRef.current = agora;
+      showToast(
+        "Uma falha foi detectada, mas seus dados locais foram preservados. Se algo não responder, recarregue a página.",
+        "warning"
+      );
+    }
+
+    function aoErro(evento: ErrorEvent) {
+      registrarErroRuntime(
+        evento.error ?? evento.message ?? "Erro de execução",
+        "window-error"
+      );
+      avisar();
+    }
+
+    function aoRejeitar(evento: PromiseRejectionEvent) {
+      registrarErroRuntime(evento.reason, "promise-rejection");
+      avisar();
+    }
+
+    window.addEventListener("error", aoErro);
+    window.addEventListener("unhandledrejection", aoRejeitar);
+
+    return () => {
+      window.removeEventListener("error", aoErro);
+      window.removeEventListener("unhandledrejection", aoRejeitar);
+    };
+  }, [showToast]);
+
+  return null;
+}
diff -ruN '--exclude=*.png' '--exclude=*.svg' base1112_clean/src/components/Sidebar/Sidebar.css latest_clean/src/components/Sidebar/Sidebar.css
--- base1112_clean/src/components/Sidebar/Sidebar.css	2026-08-09 01:14:12.000000000 +0000
+++ latest_clean/src/components/Sidebar/Sidebar.css	2026-08-16 23:52:31.000000000 +0000
@@ -388,4 +388,109 @@
   .sidebar-menu {
     grid-template-columns: 1fr;
   }
-}
\ No newline at end of file
+}
+/* Etapa 20 — navegação mobile profissional */
+.sidebar-mobile-toggle,
+.sidebar-mobile-overlay {
+  display: none;
+}
+
+@media (max-width: 900px) {
+  body.menu-mobile-aberto {
+    overflow: hidden;
+  }
+
+  .sidebar-mobile-toggle {
+    position: fixed;
+    top: 12px;
+    left: 12px;
+    z-index: 1302;
+    width: 42px;
+    height: 42px;
+    display: grid;
+    place-items: center;
+    color: #f8fafc;
+    background: rgba(15, 23, 42, .96);
+    border: 1px solid #334155;
+    border-radius: 12px;
+    box-shadow: 0 10px 28px rgba(2, 6, 23, .32);
+    font-size: 21px;
+    line-height: 1;
+    backdrop-filter: blur(12px);
+  }
+
+  .sidebar-mobile-overlay {
+    position: fixed;
+    inset: 0;
+    z-index: 1298;
+    display: block;
+    width: 100%;
+    height: 100%;
+    padding: 0;
+    background: rgba(2, 6, 23, .72);
+    border: 0;
+    backdrop-filter: blur(3px);
+  }
+
+  .sidebar {
+    position: fixed;
+    inset: 0 auto 0 0;
+    z-index: 1300;
+    width: min(86vw, 330px);
+    min-width: 0;
+    height: 100dvh;
+    padding: 66px 14px 18px;
+    border-right: 1px solid #334155;
+    border-bottom: 0;
+    box-shadow: 18px 0 45px rgba(2, 6, 23, .36);
+    transform: translateX(-105%);
+    transition: transform .24s ease;
+    overscroll-behavior: contain;
+  }
+
+  .sidebar.sidebar-mobile-aberta {
+    transform: translateX(0);
+  }
+
+  .sidebar-logo {
+    padding-top: 0;
+  }
+
+  .sidebar-menu {
+    display: flex;
+    grid-template-columns: none;
+    gap: 8px;
+  }
+
+  .sidebar-principal,
+  .sidebar-grupo {
+    width: 100%;
+  }
+
+  .sidebar-link,
+  .sidebar-grupo-botao {
+    min-height: 46px;
+  }
+
+  .sidebar-rodape {
+    display: flex;
+  }
+}
+
+@media (max-width: 420px) {
+  .sidebar {
+    width: min(90vw, 315px);
+  }
+}
+
+/* Etapa 20.1 — botão do menu mais discreto */
+@media (max-width: 600px) {
+  .sidebar-mobile-toggle {
+    top: 9px;
+    left: 9px;
+    width: 38px;
+    height: 38px;
+    border-radius: 10px;
+    font-size: 19px;
+  }
+}
