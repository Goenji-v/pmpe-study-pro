{
  "ci": {
    "collect": {
      "url": [
        "https://pmpe-study-pro-two.vercel.app/login",
        "https://pmpe-study-pro-two.vercel.app/demo"
      ],
      "numberOfRuns": 1,
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.55
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.85
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.8
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.75
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./lighthouse-report"
    }
  }
}
